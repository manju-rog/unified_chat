# 🚀 Ultimate RAG System v2.1 - Configuration
# Copy this to .env and fill in your values

# ===== REQUIRED: Claude API Key =====
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_claude_api_key_here

# ===== Optional: Override defaults =====

# Claude Configuration
# CLAUDE_MODEL=claude-3-5-sonnet-20241022
# CLAUDE_TEMPERATURE=0.7
# CLAUDE_MAX_TOKENS=8000
# MAX_CONTEXT_TOKENS=180000

# Embedding Models (all free!)
# PRIMARY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# SECONDARY_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# Chunking Configuration
# PARENT_CHUNK_SIZE=2000
# PARENT_CHUNK_OVERLAP=400
# CHILD_CHUNK_SIZE=600
# CHILD_CHUNK_OVERLAP=120

# Retrieval Configuration
# INITIAL_RETRIEVAL_K=100
# RERANK_TOP_K=50
# FINAL_TOP_K=30

# Features (set to false to disable)
# ENABLE_PARENT_CHILD_CHUNKING=true
# ENABLE_SEMANTIC_CHUNKING=true
# ENABLE_SLIDING_WINDOW=true
# ENABLE_RERANKING=true
# ENABLE_SEMANTIC_CACHE=true
# ENABLE_CONVERSATION_MEMORY=true
# ENABLE_ADVANCED_METADATA=true

# Storage Paths
# CHROMA_PERSIST_DIR=./data/chroma
# UPLOAD_DIR=./data/uploads
# CACHE_DIR=./data/cache

# Other
# DEBUG=false
# ENVIRONMENT=production
