# Backend Configuration (Optional - defaults are usually fine)

# Gemini API Key (reads from sow_gen_ai/.env by default)
# GEMINI_API_KEY=your_key_here

# Gemini Model
# GEMINI_MODEL=gemini-2.0-flash-exp

# Absence API URL
# ABSENCE_API_URL=http://localhost:8080/api

# Session Settings
# SESSION_EXPIRY_MINUTES=60
# SESSION_HISTORY_LIMIT=10
